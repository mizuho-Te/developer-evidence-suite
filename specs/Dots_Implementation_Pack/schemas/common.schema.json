{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.invalid/dots/v1/common.schema.json",
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "相対path。絶対path、..、symlinkを意味検証でも拒否"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256",
        "mediaType"
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "local_collector",
            "github_ci",
            "imported"
          ]
        },
        "trust": {
          "enum": [
            "unverified",
            "local_observed",
            "ci_verified"
          ]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "trust",
        "sourceId"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}