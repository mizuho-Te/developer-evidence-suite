{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.invalid/dots/v1/evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "enum": [
        "changeproof",
        "bugcapsule",
        "repovault"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "$ref": "common.schema.json#/$defs/origin"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/artifact"
          },
          "minItems": 0
        }
      },
      "required": [
        "algorithm",
        "files"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "observed",
              "asserted",
              "inferred"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "type",
          "text",
          "evidenceRefs"
        ]
      },
      "minItems": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "evidenceId",
    "product",
    "createdAt",
    "origin",
    "integrity",
    "claims",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "product": {
            "const": "changeproof"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "changeproof.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "const": "bugcapsule"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "bugcapsule.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "const": "repovault"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "repovault.schema.json"
          }
        }
      }
    }
  ]
}