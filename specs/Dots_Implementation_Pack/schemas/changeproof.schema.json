{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.invalid/dots/v1/changeproof.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "headSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETE",
        "FAILED",
        "CANCELLED"
      ]
    },
    "verdict": {
      "enum": [
        "FAIL",
        "INCOMPLETE",
        "REVIEW_REQUIRED",
        "PASS",
        null
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "ERROR",
              "SKIPPED",
              "NOT_RUN",
              "STALE"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "artifactRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "flaky": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "required",
          "status",
          "exitCode",
          "artifactRefs",
          "flaky"
        ]
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "info",
              "review",
              "high"
            ]
          },
          "suppressed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "ruleId",
          "file",
          "line",
          "reason",
          "severity",
          "suppressed"
        ]
      },
      "minItems": 0
    },
    "unverifiedRequirementIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "runId",
    "baseSha",
    "headSha",
    "policyDigest",
    "state",
    "verdict",
    "checks",
    "findings",
    "unverifiedRequirementIds"
  ]
}