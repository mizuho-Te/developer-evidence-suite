    "build:extension": "node scripts/build-extension.ts",
    "serve": "node scripts/serve.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jsdom": "27.0.0",
    "@types/node": "24.10.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
